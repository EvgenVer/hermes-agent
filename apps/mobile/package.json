{
  "name": "@hermes/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes mobile client",
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-constants",
        "expo-image-picker",
        "expo-linking",
        "expo-notifications",
        "expo-router",
        "react",
        "react-native-safe-area-context"
      ]
    }
  },
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.22.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:android": "node scripts/build-android.mjs",
    "test:e2e:android": "node scripts/test-android.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --config jest.config.js",
    "check": "npm run typecheck && npm run lint && npm run test -- --runInBand"
  },
  "dependencies": {
    "@hermes/shared": "file:../shared",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.101.2",
    "expo": "~57.0.12",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "react": "19.2.7",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.6.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.4",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  }
}
